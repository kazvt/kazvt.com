      "tambourine": 54,
      "shaker": 82
    },
    "generatorRanges": {
      "bass": "MIDI 36-48",
      "keys": "MIDI 48-84",
      "melody": "MIDI 60-96"
    },
    "selectionRule": "Seed + snapped VIBE choose a stable instrument rack. Loop variations change performance, never the chosen rack.",
    "restrictedLeadPolicy": "Song-specific synth presets with at least a full octave of coverage are octave-wrapped into their verified range so notes do not disappear.",
    "excludedAutomaticPresets": [
      "Altitude Limit Piano (only MIDI 0-39; too low for generated chord voicings)",
      "Final Zone Bass (does not cover the generator bass range consistently)"
    ]
  },
