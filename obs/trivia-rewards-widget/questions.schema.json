{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/obs-trivia/questions.schema.json",
  "title": "OBS Trivia Question Bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories"],
  "properties": {
    "version": { "const": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "questions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 80 },
            "uniqueItems": true
          },
          "icon": { "type": "string", "maxLength": 16 },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "enabled": { "type": "boolean" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1000 },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prompt", "answers"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$",
                  "minLength": 1,
                  "maxLength": 96
                },
                "prompt": { "type": "string", "minLength": 1, "maxLength": 320 },
                "answers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 120 }
                },
                "points": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "durationSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
                "difficulty": {
                  "type": "string",
                  "enum": ["easy", "medium", "hard"]
                },
                "explanation": { "type": "string", "maxLength": 500 },
                "enabled": { "type": "boolean" },
                "tags": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 60 }
                }
              }
            }
          }
        }
      }
    }
  }
}
